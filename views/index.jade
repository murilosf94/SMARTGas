extends layout

block content
  // Hero Section
  section.hero-section
    .hero-overlay
    .hero-content
      .hero-text
        h1 Bem-vindo à SmartGas!
        p.hero-subtitle Sua experiência de abastecimento é nossa prioridade!
        
        //- *** INÍCIO DA LÓGICA DE TURNO ***
        //- Se o usuário estiver logado, mostramos os botões
        if session.usuario
          
          //- O 'if' e o 'else' abaixo devem estar perfeitamente alinhados
          if turnoAberto
            //- *** SE O CAIXA ESTIVER ABERTO ***
            p.hero-description(style="color: #4CAF50;") Seu turno está ativo.
            
            .form-actions(style="justify-content: left; gap: 20px; margin-top: 20px;")
              a.cta-button(href="/clientes") Ir para Vendas
              a.btn-cancel(href="/turno/fechar") Fechar Caixa
          
          else
            //- *** SE O CAIXA ESTIVER FECHADO ***
            p.hero-description(style="color: #ffc107;") Você precisa abrir um turno para começar.
            
            .form-actions(style="margin-top: 20px;")
              a.cta-button(href="/turno/abrir") Abrir Caixa

        if session.usuario && session.usuario.funcao === 'admin'
          .form-actions(style="margin-top: 20px;")
            a.cta-button(href="/turno/historico") Histórico de Turnos
        //- *** FIM DA LÓGICA DE TURNO ***
          
      .hero-img.intense-glow

