extends layout 

block content
  .products-hero
    .hero-overlay
    .hero-content
      .hero-text
        h1 Nossos Produtos
        p.hero-description Descubra nossa seleção exclusiva de produtos

  .products-section
    .container
      .products-layout
        .products-grid
          each p in products
            .product-card
              .product-image-container
                if p.imageUrl
                  //- Correção: Sintaxe de link do Jade
                  a.product-link(href="/products/" + p.id)
                    img.product-image(src=p.imageUrl, alt=p.name)
                else
                  //- Correção: Sintaxe de link do Jade
                  a.product-link(href="/products/" + p.id)
                    .product-placeholder
                      .placeholder-icon 📦
                      span Sem imagem

              .product-content
                //- Correção: Sintaxe de texto
                h3.product-title= p.name
                
                //- Correção: Formatação de preço
                .product-price R$ #{parseFloat(p.price).toFixed(2)}
                
                .product-actions
                  //- Correção: Sintaxe de link do Jade
                  a.btn-buy(href="/products/" + p.id) Ver Detalhes
                  
                  if session.usuario
                    if p.stock > 0
                      //- --- [A CORREÇÃO PRINCIPAL ESTÁ AQUI] ---
                      //- Trocamos o 'a' (link GET) por um 'form' (POST)
                      form(method="POST", action="/carrinho/add/" + session.usuario.id + "/" + p.id, style="margin: 0;")
                        button.btn-cart(type="submit")
                          span.cart-icon 🛒
                          | Adicionar
                    else
                      //- [BÔNUS UX] Mostra 'Esgotado' se o estoque for 0
                      button.btn-cart(type="submit", disabled, style="background-color: #555;")
                        | Esgotado