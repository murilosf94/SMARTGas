extends ../layout

block content
  //- [OPCIONAL] CSS para colorir os números
  style.
    .valor-positivo { color: #4CAF50; }
    .valor-negativo { color: #dc3545; }
    .valor-aberto { color: #ffc107; font-style: italic; }

  .container
    //- Bloco 1: Hero
    .form-hero
      .hero-overlay
      .hero-content
        .hero-text
          h1 Histórico de Turnos
          p.hero-description Veja todos os turnos abertos e fechados.

    //- Bloco 2: O Card da Tabela
    .form-section
      .container
        .form-card
          .form-header
            h2 Relatório Completo
          
          .card-content(style="padding-bottom: 20px;")
            
            if turnos && turnos.length > 0
              table.product-table
                thead
                  tr
                    th Frentista
                    th Abertura
                    th Status
                    th Vendas (+)
                    th Despesas (-)
                    th Esperado (=)
                    th Contado (Final)
                    th Diferença
                tbody
                  each t in turnos
                    tr
                      td(data-label="Frentista")= t.frentista_nome
                      td(data-label="Abertura")= new Date(t.data_abertura).toLocaleString('pt-BR')
                      
                      //- Status: "Fechado" ou "Aberto" (em amarelo)
                      if t.status === 'fechado'
                        td(data-label="Status") Fechado
                      else
                        td.valor-aberto(data-label="Status") Aberto
                      
                      td.valor-positivo(data-label="Vendas") R$ #{t.totalVendas}
                      td.valor-negativo(data-label="Despesas") - R$ #{t.totalDespesas}
                      
                      //- Totais
                      td(data-label="Esperado") R$ #{t.valorEsperado}
                      td(data-label="Contado") R$ #{t.valorFinal}

                      //- Lógica da Diferença
                      if t.diferenca > 0
                        td.valor-positivo(data-label="Diferença") +R$ #{t.diferenca}
                      else if t.diferenca < 0
                        td.valor-negativo(data-label="Diferença") -R$ #{Math.abs(t.diferenca).toFixed(2)}
                      else
                        td(data-label="Diferença") R$ 0.00
            
            else
              .empty-state
                h3 Nenhum turno foi registrado ainda.