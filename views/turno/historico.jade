extends ../layout

block content
  //- Estilos auxiliares para os valores
  style.
    .valor-positivo { color: #28a745; font-weight: bold; }
    .valor-negativo { color: #dc3545; font-weight: bold; }
    .valor-neutro { color: #555; }
    .valor-aberto { color: #ffc107; font-weight: bold; font-style: italic; background: #333; padding: 2px 6px; border-radius: 4px; font-size: 0.8em; margin-left: 5px;}
    .product-table td { border-bottom: 1px solid #ddd; }

  .container
    .form-hero
      .hero-content
        .hero-text
          h1 Histórico de Turnos
          p Relatório detalhado para conciliação financeira.

    .form-section
      .container
        .form-card
          .form-header
            h2 Relatório Completo
          
          .card-content(style="padding-bottom: 20px; overflow-x: auto;")
            
            if turnos && turnos.length > 0
              table.product-table(style="width: 100%; border-collapse: collapse;")
                thead
                  tr
                    //- [CORREÇÃO DEFINITIVA]
                    //- Apliquei 'background-color: #333' e 'color: #ffffff' DIRETAMENTE em cada TH.
                    //- Isso garante que nenhum outro CSS sobrescreva a cor branca.
                    
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Data/Frentista
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Dinheiro (Venda)
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Cartões
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Pix/App
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Despesas
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Gaveta (Esp. / Real)
                    th(style="padding: 12px; text-align: left; background-color: #333; color: #ffffff;") Quebra de Caixa
                tbody
                  each t in turnos
                    tr
                      td(style="padding: 12px;")
                        div(style="font-weight: bold; color: #333;")= t.frentista_nome
                        div(style="font-size: 0.85em; color: #666;")= new Date(t.data_abertura).toLocaleDateString('pt-BR')
                        if t.status === 'aberto'
                           span.valor-aberto Aberto
                      
                      td.valor-positivo(style="padding: 12px;") R$ #{t.vDinheiro}
                      td(style="padding: 12px; color: #0056b3; font-weight: bold;") R$ #{t.vCartao}
                      td(style="padding: 12px; color: #6f42c1; font-weight: bold;") R$ #{t.vPix}
                      
                      td.valor-negativo(style="padding: 12px;") - R$ #{t.totalDespesas}
                      
                      td(style="padding: 12px;")
                        div(style="font-size: 0.9em; color: #666;") Esp: R$ #{t.valorEsperado}
                        if t.status === 'fechado'
                          div(style="font-weight: bold; color: #333;") Real: R$ #{t.valorFinal}
                        else
                          div -

                      if t.status === 'fechado'
                        if t.diferenca > 0
                          td.valor-positivo(style="padding: 12px;") +R$ #{t.diferenca} (Sobra)
                        else if t.diferenca < 0
                          td.valor-negativo(style="padding: 12px;") -R$ #{Math.abs(t.diferenca).toFixed(2)} (Falta)
                        else
                          td.valor-neutro(style="padding: 12px;") OK
                      else
                        td(style="padding: 12px;") -
            
            else
              .empty-state(style="padding: 20px; text-align: center; color: #666;")
                h3 Nenhum turno foi registrado ainda.