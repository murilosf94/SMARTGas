extends ../layout

block content
  .container
    .form-hero
      .hero-content
        .hero-text
          h1 Fechar Turno
          p Confira os valores por forma de pagamento e informe o saldo em dinheiro.

    .form-section
      .container
        .form-card
          .form-header
            h2 Resumo Financeiro do Turno
          
          .card-content(style="padding-top: 20px; padding-bottom: 20px;")
            style.
              .report-group { margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 10px; }
              .report-item { display: flex; justify-content: space-between; padding: 5px 0; font-size: 1rem; color: #ccc; }
              .report-item.highlight { color: #fff; font-weight: bold; font-size: 1.1rem; }
              .report-item.sub-item { padding-left: 20px; font-size: 0.95rem; color: #999; }
              .report-item .value { font-family: monospace; }
              .val-pos { color: #4CAF50; }
              .val-neg { color: #dc3545; }
              .val-neutral { color: #ffc107; }

            //- GRUPO 1: VENDAS TOTAIS
            .report-group
              .report-item.highlight
                span Total Bruto de Vendas:
                span.value R$ #{vendas.total}
              
              //- Aqui está o detalhamento que você pediu
              .report-item.sub-item
                span 💵 Dinheiro:
                span.value R$ #{vendas.dinheiro}
              .report-item.sub-item
                span 💳 Cartão Crédito:
                span.value R$ #{vendas.credito}
              .report-item.sub-item
                span 💳 Cartão Débito:
                span.value R$ #{vendas.debito}
              .report-item.sub-item
                span 📱 Pix / App:
                span.value R$ #{vendas.pix_app}

            //- GRUPO 2: CAIXA FÍSICO (GAVETA)
            .report-group
              .report-item
                span (+) Fundo de Troco Inicial:
                span.value R$ #{valorInicial}
              .report-item
                span (+) Vendas em Dinheiro:
                span.value R$ #{vendas.dinheiro}
              .report-item.val-neg
                span (-) Despesas/Sangrias:
                span.value - R$ #{totalDespesas}
              
              div(style="margin-top: 10px; border-top: 1px dashed #555; padding-top: 10px;")
                .report-item.highlight
                  span 🟢 Esperado na Gaveta (Dinheiro):
                  span.value.val-pos R$ #{valorEsperado}

          //- O Formulário para fechar
          form.product-form(method="POST", action="/turno/fechar")
            
            .form-group
              label.form-label Valor Contado em Dinheiro (R$)
              input.form-input(type="number", step="0.01", name="valor_final", placeholder="0,00", required, autofocus)
              .file-hint(style="color: #999; margin-top: 8px;")
                | Conte apenas as notas e moedas físicas. Não inclua comprovantes de cartão.

            .form-actions
              a.btn-cancel(href="/") Cancelar
              button.btn-primary(type="submit", style="background-color: #dc3545;") 
                | Encerrar Turno
                span.btn-arrow →