extends ../layout

block content
  .container
    .form-hero
      .hero-overlay
      .hero-content
        .hero-text
          h1 Venda de Combustível
          p.hero-description Selecione o combustível e o valor.

    .form-section
      .container
        .form-card
          .form-header
            h2 Registrar Venda

          form.product-form(method="POST", action="/venda-combustivel", id="venda-form")
            
            //- 1. SELEÇÃO DE COMBUSTÍVEL
            .form-group
              label.form-label Combustível
              select.form-input(name="combustivel_id", id="select-combustivel", required)
                option(value="") -- Selecione --
                each c in combustiveis
                  //- [INÍCIO DA CORREÇÃO]
                  //- Trocamos a sintaxe de crase (`) pela concatenação (+) do Jade
                  option(
                    value=c.id, 
                    data-preco=c.preco_vigente,
                    data-alerta=c.estoqueBaixo,
                    data-promo=c.emPromocao
                  )= c.nome + ' (R$ ' + parseFloat(c.preco_vigente).toFixed(3) + '/L)'
                  //- [FIM DA CORREÇÃO]
            
            //- [NOVO] AVISO DE PROMOÇÃO
            #aviso-promocao(style="display: none; text-align: center; color: #4CAF50; font-weight: bold; margin-bottom: 15px;")
              | 🎉 Preço Promocional Ativo! 🎉
            
            #alerta-estoque.form-group(style="display: none;")
              p(style="color: #dc3545; font-weight: bold; text-align: center;") 
                | ⚠️ ATENÇÃO: Estoque baixo para este combustível!
            
            //- 2. OS DOIS CAMPOS (REAIS E LITROS)
            .form-group
              label.form-label Valor (R$)
              input.form-input(type="text", inputmode="decimal", name="valor_reais", id="input-reais", placeholder="Ex: 50,00")
              
            .form-group
              label.form-label Litros (L)
              input.form-input(type="text", inputmode="decimal", name="valor_litros", id="input-litros", placeholder="Ex: 10,00")

            .form-actions
              button.btn-primary(type="submit") Registrar Venda

  //- --- SCRIPT ATUALIZADO (para aceitar vírgula e mostrar aviso de promo) ---
  script.
    const selectCombustivel = document.getElementById('select-combustivel');
    const inputReais = document.getElementById('input-reais');
    const inputLitros = document.getElementById('input-litros');
    const alertaEstoque = document.getElementById('alerta-estoque');
    const avisoPromocao = document.getElementById('aviso-promocao');
    
    let precoLitroAtual = 0;

    // Função helper para converter vírgula em ponto
    function parsePtBr(valor) {
      return parseFloat(valor.replace(',', '.')) || 0;
    }

    selectCombustivel.addEventListener('change', (e) => {
      const selectedOption = e.target.options[e.target.selectedIndex];
      precoLitroAtual = parseFloat(selectedOption.getAttribute('data-preco')) || 0;
      
      // Mostra/Esconde Alerta de Estoque
      alertaEstoque.style.display = (selectedOption.getAttribute('data-alerta') === 'true') ? 'block' : 'none';
      
      // Mostra/Esconde Aviso de Promoção
      avisoPromocao.style.display = (selectedOption.getAttribute('data-promo') === 'true') ? 'block' : 'none';
      
      inputReais.value = '';
      inputLitros.value = '';
    });

    // Quando o frentista DIGITA em REAIS
    inputReais.addEventListener('input', (e) => {
      if (!precoLitroAtual) return;
      const reais = parsePtBr(e.target.value);
      
      const litros = reais / precoLitroAtual;
      inputLitros.value = litros.toFixed(2).replace('.', ','); // Converte de volta para vírgula
    });

    // Quando o frentista DIGITA em LITROS
    inputLitros.addEventListener('input', (e) => {
      if (!precoLitroAtual) return;
      const litros = parsePtBr(e.target.value);
      
      const reais = litros * precoLitroAtual;
      inputReais.value = reais.toFixed(2).replace('.', ','); // Converte de volta para vírgula
    });