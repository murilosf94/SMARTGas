extends ../layout

block content
  .container
    .form-hero
      .hero-overlay
      .hero-content
        .hero-text
          h1 Gerenciar Combustíveis
          p.hero-description Veja o estoque, custos e atualize os preços.

    .form-section
      .container
        each combustivel in combustiveis
          .form-card(style="margin-bottom: 20px;")
            .form-header
              h2= combustivel.nome
              
              if combustivel.estoqueBaixo
                span(style="color: #dc3545; font-weight: bold;") ⚠️ ESTOQUE BAIXO!

            .card-content
              h3 Estoque Atual: #{parseFloat(combustivel.estoque_litros).toFixed(2)} Litros
              p(style="color: #999;") Nível mínimo: #{parseFloat(combustivel.estoque_minimo_litros).toFixed(2)} L
              p(style="color: #999;") Total Bombeado: #{parseFloat(combustivel.total_litros_bombeados).toFixed(0)} L
              
              if combustivel.status_manutencao === 'alerta'
                p(style="color: #ffc107; font-weight: bold;") 🔔 MANUTENÇÃO RECOMENDADA!
              
              hr(style="border-color: #444; margin: 15px 0;")
              
              //- Formulário para PREÇO e CUSTO
              form(method="POST", action='/combustiveis/' + combustivel.id + '/update', style="margin-bottom: 15px;")
                .form-group-row(style="display: flex; gap: 10px;")
                  .form-group(style="flex: 1;")
                    label.form-label Preço Venda (R$/L)
                    input.form-input(type="text", inputmode="decimal", name="preco_por_litro", value=combustivel.preco_por_litro, required)
                  
                  //- [NOVO CAMPO DE CUSTO]
                  .form-group(style="flex: 1;")
                    label.form-label Custo Compra (R$/L)
                    input.form-input(type="text", inputmode="decimal", name="custo_por_litro", value=combustivel.custo_por_litro, placeholder="0.000")
                
                .form-actions
                  button.btn-primary(type="submit") Atualizar Valores

              //- Formulário ADICIONAR ESTOQUE
              form(method="POST", action='/combustiveis/' + combustivel.id + '/update', style="margin-bottom: 15px;")
                .form-group
                  label.form-label Adicionar ao Tanque (Litros)
                  input.form-input(type="text", inputmode="decimal", name="adicionar_litros", placeholder="Ex: 5000.00")
                .form-actions
                  button.btn-save(type="submit") Adicionar Estoque

              //- Formulário REMOVER ESTOQUE
              form(method="POST", action='/combustiveis/' + combustivel.id + '/update')
                .form-group
                  label.form-label Remover do Tanque (Litros)
                  input.form-input(type="text", inputmode="decimal", name="remover_litros", placeholder="Ex: 50.00")
                .form-actions
                  button.btn-delete(type="submit") Remover do Estoque
              
              //- Formulário PROMOÇÃO
              hr(style="border-color: #444; margin: 15px 0;")
              h4(style="margin-bottom: 10px;") Configurar "Happy Hour"
              
              form(method="POST", action='/combustiveis/' + combustivel.id + '/update')
                .form-group(style="background-color: #333; padding: 10px; border-radius: 5px;")
                  label.form-label(for="promo_ativo_" + combustivel.id, style="display: flex; align-items: center; gap: 10px;")
                    input(type="checkbox", name="promo_ativo", id="promo_ativo_" + combustivel.id, checked=combustivel.promo_ativo)
                    | Ativar Preço Promocional
                
                .form-group
                  label.form-label Preço Promocional (R$)
                  input.form-input(type="text", inputmode="decimal", name="preco_promocional", value=combustivel.preco_promocional)

                .form-group(style="display: flex; gap: 10px;")
                  div(style="flex: 1;")
                    label.form-label Hora de Início
                    input.form-input(type="time", name="promo_hora_inicio", value=combustivel.promo_hora_inicio)
                  div(style="flex: 1;")
                    label.form-label Hora de Fim
                    input.form-input(type="time", name="promo_hora_fim", value=combustivel.promo_hora_fim)
                
                .form-group
                  label.form-label Dias (Ex: 1,2,3,4,5)
                  input.form-input(type="text", name="promo_dias_semana", value=combustivel.promo_dias_semana, placeholder="Dom=0, Seg=1...")
                
                .form-actions
                  button.btn-primary(type="submit") Salvar Promoção
              
              //- Formulário MANUTENÇÃO
              hr(style="border-color: #444; margin: 15px 0;")
              h4(style="margin-bottom: 10px;") Configurar Manutenção
              
              form(method="POST", action='/combustiveis/' + combustivel.id + '/update')
                .form-group
                  label.form-label Gerar Alerta a cada (Litros)
                  input.form-input(type="text", inputmode="decimal", name="limite_manutencao_litros", value=combustivel.limite_manutencao_litros, required)
                .form-actions
                  button.btn-primary(type="submit") Salvar Limite