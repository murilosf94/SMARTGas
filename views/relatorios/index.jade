extends ../layout

block content
  .container
    .form-hero
      .hero-content
        .hero-text
          h1 Relatórios Gerenciais
          p Escolha o tipo de relatório que deseja visualizar.

    .form-section
      .container
        ul(style="list-style: none; padding: 0;")
          li(style="margin-bottom: 15px;")
            .form-card
              .card-content
                h3 📈 Rentabilidade
                p Veja lucros, despesas e faturamento.
                a.btn-primary(href="/relatorios/rentabilidade") Acessar Relatório