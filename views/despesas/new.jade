extends ../layout

block content
  //- TUDO daqui para baixo deve estar indentado
  .container
    .form-hero
      .hero-overlay
      .hero-content
        .hero-text
          h1 Nova Despesa
          p.hero-description Adicione uma nova despesa ao seu controle

    .form-section
      .container
        .form-card
          .form-header
            h2 Informações da Despesa
          
          form.product-form(method="POST", action="/despesas")
            
            .form-group
              label.form-label Nome da Despesa
              input.form-input(type="text", name="name", placeholder="Ex: Conta de Luz", required)
            
            .form-group
              label.form-label Descrição
              textarea.form-textarea(name="description", placeholder="Descreva a despesa (opcional)", rows="4")
            
            .form-group
              label.form-label Valor (R$)
              input.form-input(type="number", step="0.01", name="price", placeholder="0,00", required)

            .form-actions
              a.btn-cancel(href="/despesas") Cancelar
              
              button.btn-primary(type="submit") 
                | Criar Despesa
                span.btn-arrow →