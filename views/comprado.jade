extends layout 

block content
  .products-hero
    .container
      h1.admin-title Venda Realizada com Sucesso!
  
  .products-section
    .container
      .admin-header
        h2.admin-title Detalhes da sua venda
        
        .products-sidebar
          .sidebar-card
            .sidebar-header
              h3 Resumo da Venda
            .sidebar-content
              .category-list
                .category-item
                  .category-icon 📋
                  | Status: Confirmado
              
              
              .product-actions(style="margin-top: 1rem;")
                a.btn-buy(href="/") Voltar à Loja
                a.btn-cart(href="/carrinho/#{session.usuario.id}") Ver Carrinho