// views/caixa/vendas.jade

extends ../base 

block content
  h1 Terminal de Vendas e Fidelidade

  // ----------------------------------------------------
  // A. Área de Identificação/Busca do Cliente (US-15)
  // ----------------------------------------------------
  div#fidelidade-area
    h2 Fidelidade e Pontuação
    p Digite o CPF do cliente para verificar o cadastro e pontuar a venda.
    
    div#busca-cpf-area
      input(type='text', id='cpf-input', placeholder='CPF do Cliente (apenas números)')
      button#btn-buscar(onclick='buscarCliente()') Buscar Cliente

  // ----------------------------------------------------
  // B. Formulário de Cadastro Rápido (Aparece se falhar a busca)
  // ----------------------------------------------------
  form#cadastro-rapido-form(style='display:none;')
    h3 Cliente não encontrado. Cadastro Rápido!
    p Preencha apenas o nome e telefone para pontuar esta compra.
    
    // Campo escondido para guardar o CPF digitado
    input(type='hidden', id='cadastro-cpf', name='cpf')
    
    div
      label(for='nome') Nome:
      input(type='text', id='nome-input', name='name', required=true)
    
    div
      label(for='telefone') Telefone:
      input(type='text', id='telefone-input', name='phone', required=true)
      
    button(type='submit') Cadastrar e Pontuar

  hr
  
  // ----------------------------------------------------
  // C. Script JavaScript (Lógica de interação com a API)
  // ----------------------------------------------------
  script.
    // Lógica para simular a busca e a exibição do formulário
    // OBS: Em um sistema real, 'buscarCliente()' faria uma requisição GET para 
    // verificar a existência. Aqui, vamos simular a falha para testar o cadastro.
    
    function buscarCliente() {
      const cpf = document.getElementById('cpf-input').value;
      
      if (!cpf || cpf.length !== 11) {
        alert('Por favor, insira um CPF válido com 11 dígitos.');
        return;
      }
      
      // Simulação da lógica: Se não encontrou (assume-se a falha na busca), 
      // exibe o formulário de cadastro rápido.
      const buscaArea = document.getElementById('busca-cpf-area');
      const cadastroForm = document.getElementById('cadastro-rapido-form');
      
      // Preenche o campo escondido com o CPF digitado
      document.getElementById('cadastro-cpf').value = cpf;
      
      buscaArea.style.display = 'none'; // Esconde a busca
      cadastroForm.style.display = 'block'; // Mostra o formulário
    }

    // Lógica para enviar o formulário de Cadastro Rápido para a API
    document.getElementById('cadastro-rapido-form').addEventListener('submit', async (event) => {
        event.preventDefault(); 
        
        const cpf = document.getElementById('cadastro-cpf').value;
        const name = document.getElementById('nome-input').value;
        const phone = document.getElementById('telefone-input').value;

        const data = { cpf, name, phone };
        
        try {
            // Requisição POST para o endpoint que criamos em AdminController.js
            const response = await fetch('/api/admin/customers/quick-register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok && response.status === 201) {
                alert('Cliente Fidelidade cadastrado com sucesso! ID: ' + result.customerId + '. Pontos associados à venda.');
                
                // US-15 Finalizado: O sistema deve associar os pontos da venda atual à nova conta[cite: 145].
                // Aqui você faria uma função para 'associarPontosAVenda(result.customerId)'.
                
                // Reinicia a tela para a próxima venda
                document.getElementById('cadastro-rapido-form').style.display = 'none';
                document.getElementById('cpf-input').value = '';
                document.getElementById('busca-cpf-area').style.display = 'block';

            } else {
                alert('Erro no cadastro: ' + (result.error || 'Erro desconhecido.'));
            }

        } catch (error) {
            console.error('Erro de rede:', error);
            alert('Erro ao se comunicar com o servidor.');
        }
    });